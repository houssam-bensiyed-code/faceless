# Server
PORT=3000
NODE_ENV=production

# AI Provider
AI_PROVIDER=anthropic                   # anthropic | stub
AI_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-20250514

# AI Resilience
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MS=30000
AI_RATE_LIMIT_MAX_REQUESTS=50
AI_RATE_LIMIT_WINDOW_MS=60000

# Data Store
DATASTORE_PROVIDER=google-sheets        # google-sheets | stub
GOOGLE_SHEETS_ID=1aBcDeFgHiJkL...
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google.json

# File Storage (Google Drive is production — dev and prod folders are Drive folders)
STORAGE_PROVIDER=google-drive           # google-drive | local | stub
GOOGLE_DRIVE_PARENT_FOLDER_ID=...       # Drive folder containing dev and prod subfolders
GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/google.json
LOCAL_STORAGE_BASE_PATH=./storage       # only used when STORAGE_PROVIDER=local (testing)

# Pipeline
WRITING_PATTERN_PATH=./patterns/default-writing-pattern.txt
